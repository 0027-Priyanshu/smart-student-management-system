{
  "name": "smart-student-management-backend",
  "version": "1.0.0",
  "description": "Smart Student Management Backend (MERN Stack with TS)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "db:clean": "npx ts-node src/scripts/cleanup_demo_data.ts"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "ml-logistic-regression": "^2.0.0",
    "ml-matrix": "^6.14.0",
    "mongoose": "^8.8.2",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "socket.io": "^4.8.1",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.1",
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.13.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
